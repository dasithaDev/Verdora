{
  "name": "verdora-server",
  "version": "1.0.0",
  "description": "Verdora Healthy Cafe Express API Server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seeds/seed.js",
    "check:dish": "node scripts/check-dish.js",
    "test:models": "node tests/modelTests.js",
    "test:middleware": "node tests/middlewareTests.js",
    "test:auth": "node tests/authTests.js",
    "test:menu": "node tests/menuTests.js",
    "test:orders": "node tests/orderTests.js",
    "test:reservations": "node tests/reservationTests.js",
    "test:admin": "node tests/adminTests.js",
    "test:security": "node tests/securityTests.js",
    "test": "npm run test:models && npm run test:middleware && npm run test:auth && npm run test:menu && npm run test:orders && npm run test:reservations && npm run test:admin && npm run test:security"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {}
}
